# 使い方: このファイルを .env にコピーして使う（cp .env.example .env）

# MySQL（DB_USERNAME は docker/mysql/init/01-test-db.sql の権限付与と揃えること）
DB_ROOT_PASSWORD=root
DB_DATABASE=memo
DB_USERNAME=memo
DB_PASSWORD=secret

# ホスト側のポート（他のアプリと重なるときは変える）
FRONTEND_PORT=3000
BACKEND_PORT=8000
PHPMYADMIN_PORT=8080

# 画面から見た API の URL
NEXT_PUBLIC_API_URL=http://localhost:8000
